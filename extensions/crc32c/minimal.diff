Import the builtin _crc32c module. A static Python cannot load crc32c._crc32c.

crc32c 2.7.1. Apply with `patch -p0 -i minimal.diff` from the directory
that contains the extracted crc32c-2.7.1 tree.
--- crc32c-2.7.1/src/crc32c/__init__.py
+++ crc32c-2.7.1/src/crc32c/__init__.py
@@ -1,6 +1,6 @@
 # Explicitly "import ... as" to make mypy --strict happy
-from ._crc32c import big_endian as big_endian
-from ._crc32c import crc32 as crc32
-from ._crc32c import crc32c as crc32c
-from ._crc32c import hardware_based as hardware_based
+from _crc32c import big_endian as big_endian
+from _crc32c import crc32 as crc32
+from _crc32c import crc32c as crc32c
+from _crc32c import hardware_based as hardware_based
 from ._crc32hash import CRC32CHash as CRC32CHash
--- crc32c-2.7.1/src/crc32c/_crc32hash.py
+++ crc32c-2.7.1/src/crc32c/_crc32hash.py
@@ -2,7 +2,7 @@
 
 from typing import TYPE_CHECKING
 
-from ._crc32c import crc32c
+from _crc32c import crc32c
 
 if TYPE_CHECKING:
     from typing_extensions import Buffer, Self
